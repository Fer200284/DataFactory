					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SET LANGUAGE Spanish;\nSELECT DISTINCT\n    CAST(FechaHoraCita AS DATE) AS Fecha,\n    YEAR(FechaHoraCita) AS Anio,\n    MONTH(FechaHoraCita) AS Mes,\n    DATENAME(MONTH, FechaHoraCita) AS NombreMes,\n    DAY(FechaHoraCita) AS Dia,\n    DATENAME(WEEKDAY, FechaHoraCita) AS NombreDia,\n    DATEPART(WEEK, FechaHoraCita) AS Semana,\n    DATEPART(QUARTER, FechaHoraCita) AS Trimestre,\n    CASE\n        WHEN MONTH(FechaHoraCita) <= 6 THEN 1\n        ELSE 2\n    END AS Semestre\nFROM Citas",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "DELETE FROM DIM_TIEMPO;\n\nDBCC CHECKIDENT ('DIM_TIEMPO', RESEED, 0);",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
