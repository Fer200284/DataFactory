					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT DISTINCT\n       Fecha,\n       YEAR(Fecha) AS Anio,\n       MONTH(Fecha) AS Mes,\n       DATENAME(MONTH, Fecha) AS NombreMes,\n       DAY(Fecha) AS Dia,\n       DATENAME(WEEKDAY, Fecha) AS NombreDia,\n       DATEPART(WEEK, Fecha) AS Semana,\n       DATEPART(QUARTER, Fecha) AS Trimestre,\n       CASE\n           WHEN MONTH(Fecha) <= 6 THEN 1\n           ELSE 2\n       END AS Semestre\nFROM\n(\n    SELECT CAST(FechaHoraCita AS DATE) AS Fecha\n    FROM Citas\n\n    UNION\n\n    SELECT ID_FECHA\n    FROM STG_ENCUESTA_PACIENTE\n\n    UNION\n\n    SELECT ID_FECHA\n    FROM STG_ATENCIONES_MONGO\n) F\nORDER BY Fecha;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "DELETE FROM DIM_TIEMPO;\n\nDBCC CHECKIDENT ('DIM_TIEMPO', RESEED, 0);",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
