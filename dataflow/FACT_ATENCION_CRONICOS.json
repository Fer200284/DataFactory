{
	"name": "FACT_ATENCION_CRONICOS",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ORIGEN_ATENCION_CRONICO",
						"type": "DatasetReference"
					},
					"name": "SRCATENCIONES"
				},
				{
					"dataset": {
						"referenceName": "DESTINO_DIM_TIEMPO",
						"type": "DatasetReference"
					},
					"name": "SRCDIMTIEMPO"
				},
				{
					"dataset": {
						"referenceName": "DESTINO_DIM_PACIENTE_PATOLOGIA",
						"type": "DatasetReference"
					},
					"name": "SRCDIMPACIENTEPATOLOGIA"
				},
				{
					"dataset": {
						"referenceName": "DESTINO_DIM_PACIENTE",
						"type": "DatasetReference"
					},
					"name": "SRCDIMPACIENTE"
				},
				{
					"dataset": {
						"referenceName": "DESTINO_DIM_MEDICO",
						"type": "DatasetReference"
					},
					"name": "SRCDIMMEDICO"
				},
				{
					"dataset": {
						"referenceName": "DESTINO_DIM_PATOLOGIA",
						"type": "DatasetReference"
					},
					"name": "SRCPATOLOGIA"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DESTINO_FACT_ATENCION",
						"type": "DatasetReference"
					},
					"name": "DESTINOFACTATENCION"
				}
			],
			"transformations": [
				{
					"name": "DIMTIEMPO"
				},
				{
					"name": "DIMPACIENTEPATOLOGIA"
				},
				{
					"name": "DIMPACIENTE"
				},
				{
					"name": "DIMMEDICO"
				},
				{
					"name": "DIMPATOLOGIA"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as long,",
				"          FechaAtencion as date,",
				"          Peso as decimal(5,2),",
				"          Talla as decimal(5,2),",
				"          {PresionArterial Sitolica} as string,",
				"          {PresionArterial Diastolica} as string,",
				"          FechaProximaCita as date,",
				"          Asistio as boolean,",
				"          ConsultaEspecializada as boolean,",
				"          Observaciones as string,",
				"          FechaCreacion as string,",
				"          IdMedico as long,",
				"          IdPaciente_Patologia as long,",
				"          FechaHoraLlega as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          IdCita as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCATENCIONES",
				"source(output(",
				"          IdDIMTIEMPO as integer,",
				"          Fecha as date,",
				"          Anio as integer,",
				"          Mes as integer,",
				"          NombreMes as string,",
				"          Dia as integer,",
				"          NombreDia as string,",
				"          Semana as integer,",
				"          Trimestre as integer,",
				"          Semestre as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCDIMTIEMPO",
				"source(output(",
				"          ID_DIMPaciente_Patologia as integer,",
				"          ID_PacientePatologia as long,",
				"          ID_Paciente as long,",
				"          ID_Patologia as long,",
				"          NOMBRE_PATOLOGIA as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCDIMPACIENTEPATOLOGIA",
				"source(output(",
				"          ID_DIMPACIENTE as integer,",
				"          ID_PACIENTE as long,",
				"          NOMBRE_COMPLETO as string,",
				"          FECHA_DE_NACIMIENTO as date,",
				"          SEXO as string,",
				"          BARRIO as string,",
				"          IDSECTOR_OLTP as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCDIMPACIENTE",
				"source(output(",
				"          ID_DIMMEDICO as integer,",
				"          ID_MEDICO_OLTP as long,",
				"          NOMBRE_COMPLETO as string,",
				"          ESPECIALIDAD as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCDIMMEDICO",
				"source(output(",
				"          ID_DIMPATOLOGIA as integer,",
				"          ID_PATOLOGIA_OLTP as long,",
				"          NOMBRE_PATOLOGIA as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCPATOLOGIA",
				"SRCATENCIONES, SRCDIMTIEMPO lookup(FechaAtencion == Fecha,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> DIMTIEMPO",
				"DIMTIEMPO, SRCDIMPACIENTEPATOLOGIA lookup(IdPaciente_Patologia == ID_PacientePatologia,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> DIMPACIENTEPATOLOGIA",
				"DIMPACIENTEPATOLOGIA, SRCDIMPACIENTE lookup(SRCDIMPACIENTEPATOLOGIA@ID_Paciente == SRCDIMPACIENTE@ID_PACIENTE,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> DIMPACIENTE",
				"DIMPACIENTE, SRCDIMMEDICO lookup(IdMedico == ID_MEDICO_OLTP,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> DIMMEDICO",
				"DIMMEDICO, SRCPATOLOGIA lookup(SRCDIMPACIENTEPATOLOGIA@ID_Patologia == ID_PATOLOGIA_OLTP,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> DIMPATOLOGIA",
				"DIMPATOLOGIA sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID_FACT_ATENCION as integer,",
				"          ID_ATENCION_OLTP as long,",
				"          ID_DIMPACIENTE as integer,",
				"          ID_DIMPaciente_Patologia as integer,",
				"          ID_DIMMEDICO as integer,",
				"          IdDIMTIEMPO as integer,",
				"          Peso as decimal(5,2),",
				"          Talla as decimal(5,2),",
				"          PresionSistolica as string,",
				"          PresionDiastolica as string,",
				"          Asistio as boolean,",
				"          ConsultaEspecializada as boolean,",
				"          TiempoEsperaMin as integer,",
				"          TiempoAtencionMin as integer,",
				"          RecetoMedicamentoFlag as boolean,",
				"          SolicitoExamenFlag as boolean,",
				"          ID_DIMPATOLOGIA as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ID_ATENCION_OLTP = id,",
				"          ID_DIMPACIENTE,",
				"          ID_DIMPaciente_Patologia,",
				"          ID_DIMMEDICO,",
				"          IdDIMTIEMPO,",
				"          Peso,",
				"          Talla,",
				"          PresionSistolica = {PresionArterial Sitolica},",
				"          PresionDiastolica = {PresionArterial Diastolica},",
				"          Asistio,",
				"          ID_DIMPATOLOGIA",
				"     )) ~> DESTINOFACTATENCION"
			]
		}
	}
}