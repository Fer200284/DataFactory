{
	"name": "DF_atencion_mongodb",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DESTINO_STGATENCION_MONGODB",
						"type": "DatasetReference"
					},
					"name": "SRCATENCIONESMONGO"
				},
				{
					"dataset": {
						"referenceName": "ORIGEN_DIM_PACIENTE",
						"type": "DatasetReference"
					},
					"name": "SRCPACIENTE"
				},
				{
					"dataset": {
						"referenceName": "DESTINO_DIM_MEDICO",
						"type": "DatasetReference"
					},
					"name": "SRCMEDICO"
				},
				{
					"dataset": {
						"referenceName": "DESTINO_DIM_PATOLOGIA",
						"type": "DatasetReference"
					},
					"name": "SRCpatologia"
				},
				{
					"dataset": {
						"referenceName": "DESTINO_DIM_TIEMPO",
						"type": "DatasetReference"
					},
					"name": "SRCDIMtiempo"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DESTINO_FACT_ATENCIONES",
						"type": "DatasetReference"
					},
					"name": "SINKATENCIONMONGO"
				}
			],
			"transformations": [
				{
					"name": "LKpaciente"
				},
				{
					"name": "LKMEDICO"
				},
				{
					"name": "LKPpatologia"
				},
				{
					"name": "LKPtiempo"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID_ATENCION as long,",
				"          ID_FECHA as date,",
				"          ID_PACIENTE as long,",
				"          ID_MEDICO as long,",
				"          ID_PATOLOGIA as long,",
				"          ASISTIO_VAL as integer,",
				"          DURACION_CONSULTA_MINUTOS as integer,",
				"          TIEMPO_ESPERA_REAL_MINUTOS as integer,",
				"          RECETO_MEDICAMENTO_FLAG as boolean,",
				"          SOLICITO_EXAMEN_FLAG as boolean,",
				"          FECHA_HORA_LLEGADA as timestamp,",
				"          FECHA_HORA_INICIO_CONSULTA as timestamp,",
				"          FECHA_HORA_FIN_CONSULTA as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCATENCIONESMONGO",
				"source(output(",
				"          id as long,",
				"          Nombre as string,",
				"          Apellidos as string,",
				"          sexo as string,",
				"          Fecha_de_Nacimiento as date,",
				"          celular as string,",
				"          Cedula as string,",
				"          Direccion as string,",
				"          Barrio as string,",
				"          FechaCreacion as string,",
				"          Estado as boolean,",
				"          IdSector as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCPACIENTE",
				"source(output(",
				"          ID_DIMMEDICO as integer,",
				"          ID_MEDICO_OLTP as long,",
				"          NOMBRE_COMPLETO as string,",
				"          ESPECIALIDAD as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCMEDICO",
				"source(output(",
				"          ID_DIMPATOLOGIA as integer,",
				"          ID_PATOLOGIA_OLTP as long,",
				"          NOMBRE_PATOLOGIA as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCpatologia",
				"source(output(",
				"          IdDIMTIEMPO as integer,",
				"          Fecha as date,",
				"          Anio as integer,",
				"          Mes as integer,",
				"          NombreMes as string,",
				"          Dia as integer,",
				"          NombreDia as string,",
				"          Semana as integer,",
				"          Trimestre as integer,",
				"          Semestre as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCDIMtiempo",
				"SRCATENCIONESMONGO, SRCPACIENTE lookup(ID_PACIENTE == id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LKpaciente",
				"LKpaciente, SRCMEDICO lookup(ID_MEDICO == ID_MEDICO_OLTP,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LKMEDICO",
				"LKMEDICO, SRCpatologia lookup(ID_PATOLOGIA == ID_PATOLOGIA_OLTP,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LKPpatologia",
				"LKPpatologia, SRCDIMtiempo lookup(ID_FECHA == Fecha,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LKPtiempo",
				"LKPtiempo sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID_ATENCION as long,",
				"          ID_FECHA as date,",
				"          ID_PACIENTE as long,",
				"          ID_MEDICO as long,",
				"          ID_PATOLOGIA as long,",
				"          ASISTIO_VAL as integer,",
				"          DURACION_CONSULTA_MINUTOS as integer,",
				"          TIEMPO_ESPERA_REAL_MINUTOS as integer,",
				"          RECETO_MEDICAMENTO_FLAG as boolean,",
				"          SOLICITO_EXAMEN_FLAG as boolean,",
				"          FECHA_HORA_LLEGADA as timestamp,",
				"          FECHA_HORA_INICIO_CONSULTA as timestamp,",
				"          FECHA_HORA_FIN_CONSULTA as timestamp",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ID_FECHA,",
				"          ID_PACIENTE,",
				"          ID_MEDICO,",
				"          ID_PATOLOGIA,",
				"          ASISTIO_VAL,",
				"          DURACION_CONSULTA_MINUTOS,",
				"          TIEMPO_ESPERA_REAL_MINUTOS,",
				"          RECETO_MEDICAMENTO_FLAG,",
				"          SOLICITO_EXAMEN_FLAG,",
				"          FECHA_HORA_LLEGADA,",
				"          FECHA_HORA_INICIO_CONSULTA,",
				"          FECHA_HORA_FIN_CONSULTA",
				"     )) ~> SINKATENCIONMONGO"
			]
		}
	}
}