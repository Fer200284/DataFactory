{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlDim_paciente_patologia_origen",
						"type": "DatasetReference"
					},
					"name": "origenPP"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlDim_paciente_destino",
						"type": "DatasetReference"
					},
					"name": "srpaciente"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlDim_patologia_destino",
						"type": "DatasetReference"
					},
					"name": "srpatologia"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqldestino_dimesionpp",
						"type": "DatasetReference"
					},
					"name": "destinopp"
				}
			],
			"transformations": [
				{
					"name": "dimPaciente"
				},
				{
					"name": "dimpatologia"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as long,",
				"          fecha_de_Diagnostico as date,",
				"          Estado as boolean,",
				"          Observaciones as string,",
				"          Idpaciente as long,",
				"          IDPatologiaCRonica as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select id ,idpaciente, IDPatologiaCRonica from DIM_PATOLOGIA_CRONICA',",
				"     format: 'query') ~> origenPP",
				"source(output(",
				"          IdpacienteDW as long,",
				"          NOMBRE_COMPLETO as string,",
				"          Barrio as string,",
				"          fecha_de_nacimiento as date,",
				"          celular as string,",
				"          idpacienteOLTP as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srpaciente",
				"source(output(",
				"          ID_DM_paciente as long,",
				"          Nnombre_patologia as string,",
				"          ID_OLTP as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srpatologia",
				"origenPP, srpaciente lookup(id == IdpacienteDW,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> dimPaciente",
				"dimPaciente, srpatologia lookup(id == ID_DM_paciente,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> dimpatologia",
				"dimpatologia sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID_DIM_P_P as long,",
				"          IdpacienteDW as long,",
				"          ID_DM_paciente as long,",
				"          ID_OLTP as long",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IdpacienteDW,",
				"          ID_DM_paciente,",
				"          ID_OLTP",
				"     )) ~> destinopp"
			]
		}
	}
}